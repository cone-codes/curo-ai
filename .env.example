# Scraping (defaults favor local headed browser + persistent profile)
SCRAPE_HEADLESS=false
SCRAPE_PERSISTENT_PROFILE=true
SCRAPE_USER_DATA_DIR=
SCRAPE_WARMUP_ENABLED=true
SCRAPE_USE_STEALTH=true
SCRAPE_STOP_ON_BLOCK=true
SCRAPE_FALLBACK_TO_SEED=true

SCRAPE_MAX_PAGES=3
SCRAPE_LIST_URL=https://www.therealreal.com/sales/shop-new-arrivals-5753
# Comma-separated additional listing pages
SCRAPE_LIST_URLS=

SCRAPE_TIMEOUT_MS=90000
SCRAPE_DELAY_MIN_MS=2000
SCRAPE_DELAY_MAX_MS=6000
SCRAPE_WARMUP_DELAY_MIN_MS=2500
SCRAPE_WARMUP_DELAY_MAX_MS=5000
SCRAPE_SCROLL_STEPS=4

SCRAPE_HOME_URL=https://www.therealreal.com/

# --- See the browser (debug) ---
SCRAPE_HEADLESS=false
SCRAPE_SLOW_MO_MS=300
SCRAPE_KEEP_BROWSER_OPEN_SECONDS=45
# Optional: use system Chrome (run: python3 -m playwright install chrome)
# SCRAPE_BROWSER_CHANNEL=chrome

# The RealReal requires login to view listings — sign in once in the headed browser
SCRAPE_REQUIRE_LOGIN=true
SCRAPE_LOGIN_URL=https://www.therealreal.com/?auth_modal[view]=login
SCRAPE_LOGIN_WAIT_SECONDS=180
SCRAPE_HEADLESS=false
SCRAPE_KEEP_BROWSER_OPEN_SECONDS=30

SCRAPE_OPEN_LANDING_ON_NO_NEW=true
SCRAPE_RETRY_AFTER_SIGN_IN=true

# Click 'Continue with Google' on TRR (you finish OAuth in the browser)
SCRAPE_PREFER_GOOGLE_SIGN_IN=true
# Optional: use Chrome so your Google session may already be signed in
# SCRAPE_BROWSER_CHANNEL=chrome

# Login-first flow (recommended)
SCRAPE_HEADLESS=false
SCRAPE_LOGIN_FIRST=true
SCRAPE_REQUIRE_LOGIN=true
SCRAPE_FALLBACK_TO_SEED=false
SCRAPE_KEEP_BROWSER_OPEN_SECONDS=120
SCRAPE_WARMUP_ENABLED=false

# Chrome CDP crawler (recommended — uses your real Chrome)
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_CRAWL_MAX_LISTINGS=40
# Human-paced crawl (12-28s between listings, slow scroll + read pauses)
CHROME_CRAWL_DELAY_MIN_MS=12000
CHROME_CRAWL_DELAY_MAX_MS=28000
CHROME_CRAWL_PRE_NAV_MIN_MS=3000
CHROME_CRAWL_PRE_NAV_MAX_MS=8000
CHROME_CRAWL_READ_MIN_MS=6000
CHROME_CRAWL_READ_MAX_MS=15000
CHROME_CRAWL_SCROLL_STEPS=8
CHROME_CRAWL_SCROLL_PAUSE_MIN_MS=1800
CHROME_CRAWL_SCROLL_PAUSE_MAX_MS=4200
# Pause when captcha/login appears; you fix it in Chrome, crawl continues automatically
CHROME_CRAWL_WAIT_FOR_MANUAL=true
CHROME_CRAWL_MANUAL_WAIT_SECONDS=600
CHROME_CRAWL_MANUAL_WAIT_FOR=captcha,login_required,blocked,page_not_ready


# passive = you browse in Chrome (recommended); active = auto-navigate
CHROME_CRAWL_MODE=passive
CHROME_CRAWL_PASSIVE_POLL_SECONDS=3

# ScrapFly (https://scrapfly.io) — cloud scrape with PerimeterX bypass
SCRAPFLY_API_KEY=
SCRAPFLY_COUNTRY=us
SCRAPFLY_ASP=true
SCRAPFLY_RENDER_JS=true
SCRAPFLY_PROXY_POOL=public_residential_pool
SCRAPFLY_AUTO_SCROLL=true
SCRAPFLY_COST_BUDGET=50
SCRAPFLY_MAX_LISTINGS=40
SCRAPFLY_DELAY_SECONDS=2
SCRAPFLY_SESSION=trr-scrape
SCRAPFLY_USE_COOKIES_FILE=true
SCRAPFLY_LOGIN_FIRST=false
SCRAPFLY_SKIP_LOGIN_IF_COOKIES=true
